---
layout: default
---
<div class="post layout-about">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true mobile_src="assets/img/mobile-avatar.png"
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Live flight (auto-shown by JS on the flight day) -->
    {% assign fd = site.data.flights %}
    <div id="ab-live-wrap" style="display:none; margin-bottom:1.5rem;">
      <h2><a id="ab-live-title" href="{{ '/flights/' | relative_url }}" style="color:inherit">in the air ✈&#xFE0E;</a><a href="{{ '/flights/' | relative_url }}" class="ab-see-more">↗&#xFE0E;</a></h2>

      <!-- Same card design as flights page -->
      <div id="ab-live-card" class="live-card">
        <div class="live-header">
          <div id="ab-badge" class="live-badge"><span class="live-dot"></span> In the Air</div>
          <div class="live-meta">
            <img id="ab-lv-logo" src="" alt="" class="live-logo" onerror="this.style.display='none'"/>
            <span id="ab-lv-airline" class="live-airline"></span>
            <span id="ab-lv-num" class="live-num"></span>
          </div>
          <a id="ab-lv-link" href="#" target="_blank" rel="noopener noreferrer" class="live-btn">Google ↗&#xFE0E;</a>
        </div>
        <div class="live-route">
          <div class="live-stop">
            <div class="live-time"><span id="ab-dep-time"></span><span id="ab-dep-tz" class="live-tz"></span></div>
            <div id="ab-dep-code" class="live-code"></div>
          </div>
          <div class="live-track">
            <div id="ab-dur" class="live-dur"></div>
            <div class="live-bar">
              <div class="live-bar-done" id="ab-progress"></div>
              <div class="live-plane" id="ab-plane">✈</div>
            </div>
            <div id="ab-terminal" class="live-terminal"></div>
          </div>
          <div class="live-stop live-stop--right">
            <div class="live-time"><span id="ab-arr-time"></span><span id="ab-arr-tz" class="live-tz"></span></div>
            <div id="ab-arr-code" class="live-code"></div>
          </div>
        </div>
      </div>

      <!-- Small map -->
      <div id="ab-map" style="width:100%;height:250px;border-radius:14px;overflow:hidden;border:1px solid var(--global-divider-color);background:var(--global-card-bg-color);margin-top:.8rem;"></div>
    </div>

    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://basemaps.cartocdn.com" crossorigin>

    <script>
    var AB_FLIGHTS = [
      {% assign t_idx = 0 %}{% for trip in fd.trips %}{% assign trip_first = trip.flights | first %}{% assign trip_last = trip.flights | last %}{% for fl in trip.flights %}{
        number:"{{ fl.number }}",airline:"{{ fl.airline }}",
        date:"{{ fl.date }}",
        fromTime:"{{ fl.from_time }}",fromTz:"{{ fl.from_tz }}",fromCode:"{{ fl.from_code }}",fromCity:"{{ fl.from_city }}",
        toTime:"{{ fl.to_time }}",toTz:"{{ fl.to_tz }}",toCode:"{{ fl.to_code }}",toCity:"{{ fl.to_city }}",
        duration:"{{ fl.duration }}",aircraft:"{{ fl.aircraft }}",
        tripFrom:"{{ trip_first.from_city }}",tripTo:"{{ trip_last.to_city }}",
        tripIdx:{{ t_idx }}
      },{% endfor %}{% assign t_idx = t_idx | plus: 1 %}{% endfor %}
    ];
    var AB_TRIPS = [
      {% for trip in fd.trips %}[
        {% for fl in trip.flights %}{from:"{{ fl.from_code }}",to:"{{ fl.to_code }}",date:"{{ fl.date }}",dep:"{{ fl.from_time }}",depTz:"{{ fl.from_tz }}",dur:"{{ fl.duration }}"},{% endfor %}
      ],{% endfor %}
    ];
    var AB_ICAO = { {% for k in fd.airline_icao %}"{{ k[0] }}":"{{ k[1] }}",{% endfor %} };
    var AB_AP   = { {% for ap in fd.airports %}"{{ ap[0] }}":[{{ ap[1].lat }},{{ ap[1].lng }}],{% endfor %} };

    (function(){
      function toUTC(dateStr,timeStr,tzStr){
        var tm=timeStr.match(/(\d+):(\d+)\s*(AM|PM)/i);
        if(!tm)return null;
        var h=parseInt(tm[1]),m=parseInt(tm[2]),ap=tm[3].toUpperCase();
        if(ap==='AM'&&h===12)h=0; if(ap==='PM'&&h!==12)h+=12;
        var pad=function(n){return n<10?'0'+n:n;};
        var tz=tzStr.match(/GMT([+-])(\d+)/);
        var off=tz?parseInt(tz[1]+'1')*parseInt(tz[2]):0;
        var d=new Date(dateStr+' '+pad(h)+':'+pad(m)+':00 UTC');
        return new Date(d.getTime()-off*3600000);
      }
      function parseDurMs(dur){
        var m=dur.match(/(\d+)h\s*(?:(\d+)m)?/);
        return m?(parseInt(m[1])*60+parseInt(m[2]||0))*60000:0;
      }

      var now=new Date();
      var cFlying=null,cScheduled=null,cArrived=null;
      for(var i=0;i<AB_FLIGHTS.length;i++){
        var fl=AB_FLIGHTS[i];
        var d=toUTC(fl.date,fl.fromTime,fl.fromTz);
        var a=new Date(d.getTime()+parseDurMs(fl.duration));
        var showFrom=new Date(d.getTime()-6*3600000);
        var su=new Date(a);su.setUTCHours(0,0,0,0);su.setUTCDate(su.getUTCDate()+1);
        if(now<showFrom||now>su)continue;
        var state=now<d?'scheduled':now<=a?'flying':'arrived';
        var c={fl:fl,d:d,a:a,su:su,state:state};
        if(state==='flying'    &&!cFlying)                        cFlying=c;
        if(state==='scheduled' &&!cScheduled)                     cScheduled=c;
        if(state==='arrived'   &&(!cArrived||a>cArrived.a))       cArrived=c;
      }
      var chosen=cFlying||cScheduled||cArrived;
      /* Lookahead: if the chosen leg has arrived, promote the next connecting leg
         in the same trip that departs within 24 h (handles overnight layovers
         whose date-based showFrom hasn't opened yet) */
      if(chosen&&chosen.state==='arrived'){
        var connTripIdx=chosen.fl.tripIdx,connArr=chosen.a,cNext=null;
        for(var j=0;j<AB_FLIGHTS.length;j++){
          var fl2=AB_FLIGHTS[j];
          if(fl2.tripIdx!==connTripIdx)continue;
          var d2=toUTC(fl2.date,fl2.fromTime,fl2.fromTz);
          if(d2<=connArr||d2-now>24*3600000)continue;
          if(!cNext||d2<toUTC(cNext.fl.date,cNext.fl.fromTime,cNext.fl.fromTz)){
            var a2=new Date(d2.getTime()+parseDurMs(fl2.duration));
            var su2=new Date(a2);su2.setUTCHours(0,0,0,0);su2.setUTCDate(su2.getUTCDate()+1);
            cNext={fl:fl2,d:d2,a:a2,su:su2,state:now<d2?'scheduled':now<=a2?'flying':'arrived'};
          }
        }
        if(cNext)chosen=cNext;
      }
      if(!chosen)return;
      var active=chosen.fl,dep=chosen.d,arr=chosen.a,
          showUntil=chosen.su,flightState=chosen.state;

      var abBadge=document.getElementById('ab-badge');
      var abTitle=document.getElementById('ab-live-title');
      var TRIP=active.tripFrom+' ✈ '+active.tripTo;
      function setBadge(state){
        if(state==='flying'){abBadge.className='live-badge';abBadge.innerHTML='<span class="live-dot"></span> In the Air';}
        else if(state==='scheduled'){abBadge.className='live-badge live-badge--scheduled';abBadge.textContent='Scheduled';}
        else{abBadge.className='live-badge live-badge--arrived';abBadge.textContent='Arrived';}
        if(abTitle)abTitle.textContent=TRIP;
      }
      setBadge(flightState);

      var ac=active.number.slice(0,2),num=active.number.slice(2);
      var icao=AB_ICAO[ac]||ac;
      document.getElementById('ab-lv-logo').src='https://www.gstatic.com/flights/airline_logos/70px/'+ac+'.png';
      document.getElementById('ab-lv-airline').textContent=active.airline;
      document.getElementById('ab-lv-num').textContent=active.number;
      document.getElementById('ab-lv-link').href='https://www.google.com/search?q='+encodeURIComponent(ac+num+' flight status '+active.date);
      document.getElementById('ab-dep-time').textContent=active.fromTime;
      document.getElementById('ab-dep-tz').textContent=active.fromTz;
      document.getElementById('ab-dep-code').textContent=active.fromCode;
      document.getElementById('ab-arr-time').textContent=active.toTime;
      document.getElementById('ab-arr-tz').textContent=active.toTz;
      document.getElementById('ab-arr-code').textContent=active.toCode;
      document.getElementById('ab-dur').textContent=active.duration;
      document.getElementById('ab-terminal').textContent=active.aircraft;

      var bar=document.getElementById('ab-progress');
      var plane=document.getElementById('ab-plane');
      var total=arr-dep;
      function tick(){
        var now=new Date();
        if(now>showUntil){document.getElementById('ab-live-wrap').style.display='none';clearInterval(timer);return;}
        var state=now<dep?'scheduled':now<=arr?'flying':'arrived';
        setBadge(state);
        if(state==='scheduled'){bar.style.width='0%';plane.style.display='none';}
        else if(state==='flying'){plane.style.display='';var pct=Math.min(100,Math.max(0,(now-dep)/total*100));bar.style.width=pct+'%';plane.style.left='calc('+pct+'% - 10px)';}
        else{plane.style.display='none';bar.style.width='100%';}
      }
      tick(); var timer=setInterval(tick,10000);
      document.getElementById('ab-live-wrap').style.display='';

      /* Load Leaflet & draw map */
      var css=document.createElement('link');
      css.rel='stylesheet';css.href='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css';
      document.head.appendChild(css);
      var js=document.createElement('script');
      js.src='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js';
      js.onload=function(){
        var from=AB_AP[active.fromCode],to=AB_AP[active.toCode];
        if(!from||!to)return;
        var map=L.map('ab-map',{zoomControl:true,scrollWheelZoom:false,attributionControl:false,dragging:true});
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',{subdomains:'abcd'}).addTo(map);
        function gc(a,b){
          var n=60,D=Math.PI/180,f1=a[0]*D,l1=a[1]*D,f2=b[0]*D,l2=b[1]*D;
          var d=2*Math.asin(Math.sqrt(Math.pow(Math.sin((f2-f1)/2),2)+Math.cos(f1)*Math.cos(f2)*Math.pow(Math.sin((l2-l1)/2),2)));
          if(!d)return[a,b];
          var pts=[];
          for(var i=0;i<=n;i++){var t=i/n,A=Math.sin((1-t)*d)/Math.sin(d),B=Math.sin(t*d)/Math.sin(d);
            var x=A*Math.cos(f1)*Math.cos(l1)+B*Math.cos(f2)*Math.cos(l2);
            var y=A*Math.cos(f1)*Math.sin(l1)+B*Math.cos(f2)*Math.sin(l2);
            var z=A*Math.sin(f1)+B*Math.sin(f2);
            pts.push([Math.atan2(z,Math.sqrt(x*x+y*y))/D,Math.atan2(y,x)/D]);}
          return pts;
        }
        function fix(pts){var out=[[pts[0][0],pts[0][1]]];for(var i=1;i<pts.length;i++){var dlng=pts[i][1]-out[i-1][1],lng=pts[i][1];if(dlng>180)lng-=360;if(dlng<-180)lng+=360;out.push([pts[i][0],lng]);}return out;}
        function bearing(a,b){var R=Math.PI/180,la=a[0]*R,lo1=a[1]*R,lb=b[0]*R,lo2=b[1]*R,dL=lo2-lo1,y=Math.sin(dL)*Math.cos(lb),x=Math.cos(la)*Math.sin(lb)-Math.sin(la)*Math.cos(lb)*Math.cos(dL);return(Math.atan2(y,x)/R+360)%360;}

        /* Draw all legs of the trip */
        var tripLegs=AB_TRIPS[active.tripIdx]||[];
        var now2=new Date(),boundPts=[],planePos=null,planeRot=0;
        for(var li=0;li<tripLegs.length;li++){
          var leg=tripLegs[li];
          var lFrom=AB_AP[leg.from],lTo=AB_AP[leg.to];
          if(!lFrom||!lTo)continue;
          var lPts=fix(gc(lFrom,lTo));
          boundPts=boundPts.concat([lFrom,lTo,lPts[Math.floor(lPts.length/2)]]);
          var lDep=toUTC(leg.date,leg.dep,leg.depTz);
          var lArr=new Date(lDep.getTime()+parseDurMs(leg.dur));
          /* Full dashed gray */
          L.polyline(lPts,{color:'#dadce0',weight:2,dashArray:'5 4'}).addTo(map);
          if(now2>=lDep){
            if(now2<=lArr){
              /* Currently flying this leg */
              var pct=Math.min(1,(now2-lDep)/(lArr-lDep));
              var idx2=Math.min(Math.floor(pct*lPts.length),lPts.length-1);
              if(idx2>0)L.polyline(lPts.slice(0,idx2+1),{color:'#1a73e8',weight:3}).addTo(map);
              planePos=lPts[idx2];
              planeRot=Math.round(bearing(lFrom,lTo)-90);
            } else {
              /* Past leg — full blue */
              L.polyline(lPts,{color:'#1a73e8',weight:3}).addTo(map);
            }
          }
          /* Airport dot */
          L.circleMarker(lFrom,{radius:5,fillColor:'#1a73e8',color:'#fff',weight:2,fillOpacity:1}).addTo(map);
          if(li===tripLegs.length-1)
            L.circleMarker(lTo,{radius:5,fillColor:'#1a73e8',color:'#fff',weight:2,fillOpacity:1}).addTo(map);
        }
        /* Plane marker on current position */
        if(planePos&&flightState!=='arrived'){
          var planeIcon=L.divIcon({className:'',html:'<div style="transform:rotate('+planeRot+'deg);width:24px;height:24px;display:flex;align-items:center;justify-content:center"><div class="map-plane">✈</div></div>',iconSize:[24,24],iconAnchor:[12,12]});
          L.marker(planePos,{icon:planeIcon}).addTo(map);
        } else if(flightState==='scheduled'){
          var schedFrom=AB_AP[active.fromCode],schedTo=AB_AP[active.toCode];
          if(schedFrom){
            var schedRot=schedTo?Math.round(bearing(schedFrom,schedTo)-90):0;
            var planeIcon2=L.divIcon({className:'',html:'<div style="transform:rotate('+schedRot+'deg);width:24px;height:24px;display:flex;align-items:center;justify-content:center"><div class="map-plane">✈</div></div>',iconSize:[24,24],iconAnchor:[12,12]});
            L.marker(schedFrom,{icon:planeIcon2}).addTo(map);
          }
        }
        var pad=window.innerWidth<600?[30,30]:[45,45];
        map.fitBounds(boundPts,{padding:pad});
      };
      document.head.appendChild(js);
    })();
    </script>

    <style>
      /* live-* classes — dark-mode aware */
      .live-card {
        border: 1.5px solid color-mix(in srgb, #1a73e8 40%, transparent);
        border-radius: 14px; padding: 1rem 1.2rem; margin-bottom: 0;
        background: color-mix(in srgb, #1a73e8 6%, var(--global-bg-color, #fff));
        box-shadow: 0 2px 12px rgba(26,115,232,.1);
      }
      .live-header { display:flex; align-items:center; gap:.6rem; margin-bottom:.9rem; flex-wrap:wrap; }
      .live-badge { display:inline-flex; align-items:center; gap:.35rem; font-size:.7rem; font-weight:700; letter-spacing:.08em; color:#c0392b; background:rgba(192,57,43,.08); border:1px solid rgba(192,57,43,.25); border-radius:20px; padding:.18rem .6rem; }
      .live-badge--scheduled { color:#1a73e8; background:rgba(26,115,232,.08); border-color:rgba(26,115,232,.25); }
      .live-badge--arrived   { color:#1e8e3e; background:rgba(30,142,62,.08);  border-color:rgba(30,142,62,.25); }
      .live-dot { width:7px; height:7px; border-radius:50%; background:#c0392b; animation:live-pulse 1.3s ease-in-out infinite; }
      @keyframes live-pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:.35;transform:scale(.8);} }
      .live-logo { height:20px; width:auto; object-fit:contain; margin-left:auto; }
      .live-airline { font-size:.85rem; font-weight:500; color:var(--global-text-color); }
      .live-num { font-size:.75rem; color:var(--global-text-color-light); }
      .live-btn { margin-left:auto; font-size:.72rem; font-weight:600; color:#1a73e8; border:1px solid rgba(26,115,232,.35); border-radius:4px; padding:.1rem .45rem; text-decoration:none; transition:background .15s; }
      .live-btn:hover { background:rgba(26,115,232,.08); text-decoration:none; }
      .live-route { display:flex; align-items:center; gap:.6rem; }
      .live-stop { flex:0 0 120px; white-space:nowrap; }
      .live-stop--right { text-align:right; }
      .live-time { font-size:1.45rem; font-weight:400; color:var(--global-text-color); line-height:1; letter-spacing:-.01em; white-space:nowrap; }
      .live-tz { font-size:.75rem; color:var(--global-text-color-light); display:block; margin-top:.2rem; }
      .live-code { font-size:1rem; font-weight:700; color:var(--global-text-color); margin-top:.22rem; }
      .live-track { flex:1; text-align:center; min-width:0; }
      .live-dur { font-size:.88rem; font-weight:500; color:var(--global-text-color-light); margin-bottom:.4rem; }
      .live-bar { position:relative; height:4px; background:var(--global-divider-color); border-radius:4px; margin-bottom:.3rem; }
      .live-bar-done { position:absolute; left:0; top:0; height:100%; background:#1a73e8; border-radius:4px; transition:width .5s ease; }
      .live-plane { position:absolute; top:50%; font-size:1.3rem; line-height:1; animation:fly-bob .9s ease-in-out infinite alternate; filter:drop-shadow(0 1px 3px rgba(26,115,232,.4)); }
      @keyframes fly-bob { from{transform:translateY(-80%);} to{transform:translateY(-40%);} }
      .map-plane { font-size:1.3rem; line-height:1; color:#000; filter:drop-shadow(0 1px 4px rgba(26,115,232,.6)); animation:fly-bob .9s ease-in-out infinite alternate; }
      html[data-theme=dark] .map-plane { color:#1a73e8; }
      .live-terminal { font-size:.80rem; color:var(--global-text-color-light); margin-top:.25rem; white-space:nowrap; text-align:center; display:block; }
      @media (max-width:399px) { .live-btn { display:none; } }
    </style>

    <style>
      /* ── Section headings on the about page ── */
      .post article h2 {
        font-size: 1.5rem !important;
        font-weight: 800;
        color: var(--global-text-color);
        margin-top: 1.8rem;
        margin-bottom: 1rem;
        padding-bottom: .45rem;
        border-bottom: 2px solid color-mix(in srgb, var(--global-theme-color, #b509ac) 30%, transparent);
        display: flex;
        align-items: center;
        gap: .5rem;
      }
      .post article h2 a {
        color: inherit !important;
        text-decoration: none;
        transition: color .18s;
      }
      .post article h2 a:hover {
        color: var(--global-theme-color, #b509ac) !important;
      }
      .ab-see-more {
        margin-left: auto;
        font-size: 1rem;
        color: var(--global-text-color-light) !important;
        text-decoration: none;
        opacity: .6;
        transition: opacity .18s, color .18s;
        line-height: 1;
      }
      .ab-see-more:hover {
        opacity: 1;
        color: var(--global-theme-color, #b509ac) !important;
        text-decoration: none !important;
      }


    </style>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
        <a href="{{ '/news/' | relative_url }}" class="ab-see-more">↗&#xFE0E;</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
        <a href="{{ '/blog/' | relative_url }}" class="ab-see-more">↗&#xFE0E;</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
        <a href="{{ '/publications/' | relative_url }}" class="ab-see-more">↗&#xFE0E;</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

<div class="visitor-map">
<script type='text/javascript' id='mapmyvisitors' src='https://mapmyvisitors.com/map.js?cl=ffffff&w=300&t=n&d=Uf_aXBUFu062aKf--j9tY_fEh494M-Tp0yps-p0dmyc'></script>
</div>