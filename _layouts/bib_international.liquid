---
---
{%- assign asize = entry.author_array | size -%}
{%- for author in entry.author_array -%}
  {%- assign is_self = false -%}
  {%- assign last_clean = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
  {%- if site.scholar.last_name contains last_clean -%}
    {%- if site.scholar.first_name contains author.first -%}
      {%- assign is_self = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- unless forloop.first -%}, {% endunless -%}
  {%- if forloop.last and asize > 1 %}and {% endif -%}
  {%- if is_self -%}<b>{{ author.first }} {{ author.last }}</b>{%- else -%}{{ author.first }} {{ author.last }}{%- endif -%}
{%- endfor %}, "{{ entry.title }}," <span class="venue">{% if entry.type == 'article' %}{{ entry.journal }}{% else %}{% unless entry.pub_group contains 'dc' %}In {% endunless %}{{ entry.booktitle }}{% endif %}</span>{% if entry.impact_factor %} <span class="if-badge">IF&nbsp;{{ entry.impact_factor }}</span>{% endif %}{% if entry.doi %} {% if entry.doi contains '://' %}<a href="{{ entry.doi }}" class="doi-badge" target="_blank"><i class="ai ai-doi"></i> DOI</a>{% else %}<a href="https://doi.org/{{ entry.doi }}" class="doi-badge" target="_blank"><i class="ai ai-doi"></i> DOI</a>{% endif %}{% endif %}{% if entry.arxiv %} {% if entry.arxiv contains '://' %}<a href="{{ entry.arxiv }}" class="arxiv-badge" target="_blank"><i class="ai ai-arxiv"></i> arXiv</a>{% else %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="arxiv-badge" target="_blank"><i class="ai ai-arxiv"></i> arXiv</a>{% endif %}{% endif %}{% if entry.pdf %} {% if entry.pdf contains '://' %}<a href="{{ entry.pdf }}" class="pdf-badge" target="_blank"><i class="fa-solid fa-file-pdf"></i> PDF</a>{% else %}<a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="pdf-badge" target="_blank"><i class="fa-solid fa-file-pdf"></i> PDF</a>{% endif %}{% endif %}{% if entry.html %} <a href="{{ entry.html }}" class="web-badge" target="_blank" title="Project page" aria-label="Project page"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>{% endif %}{% comment %} Code/GitHub badge — hidden for now, revisit on front-end {% if entry.code %} <a href="{{ entry.code }}" class="code-badge" target="_blank" title="Code" aria-label="Code"><i class="fa-brands fa-github"></i></a>{% endif %} {% endcomment %}{% if entry.award_name %} <span class="award-badge">{{ entry.award_name }}</span>{% endif %}
